<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IonaFlashServer</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- iona.bin と flash_local.html を実行ファイルに埋め込む。
         ファイル単体を持ち歩かなくても exe だけで完結させるため。 -->
    <EmbeddedResource Include="Resources\iona.bin" />
    <EmbeddedResource Include="Resources\flash_local.html" />
  </ItemGroup>

</Project>
